# ══════════════════════════════════════════════════════
#  PIK Exchange Bot — environment
# ══════════════════════════════════════════════════════

# توکن ربات از @BotFather
BOT_TOKEN=

# آیدی عددی ادمین‌ها (از @userinfobot) — با کاما جدا کنید: 111,222
ADMIN_IDS=0

# آیدی یا لینک پشتیبانی که به کاربر نمایش داده می‌شود (مثال: @pik_support)
SUPPORT_USERNAME=

# آدرس منبع نرخ (پیش‌فرض alanchand)
RATE_URL=https://alanchand.com/en

# مسیر فایل دیتابیس
DB_PATH=pik.db

# خواندن اختیاری عکس فیش (تصویر برای استخراج به OpenAI ارسال می‌شود)
# کلید را فقط در .env سرور تنظیم کنید؛ در تلگرام نفرستید.
OPENAI_API_KEY=
RECEIPT_OCR_MODEL=gpt-4.1-mini
